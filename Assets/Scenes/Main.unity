--- !u!114 &1254853343
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1254853341}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_sanctum_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 55add3bf9ff7b044489609863ad4fd16, type: 3}
    text: "Sanctum lets you spend Blessing Scales to temporarily increase a Job Site\u2019s
      storage cap."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Use the dropdown to select which Job Site you want to boost.

      The
      site icon updates to match your selection.'
  - icon: {fileID: -4330508236222623831, guid: a5945cdf547864b8787a2d4106457745, type: 3}
    text: "Each blessing costs 1 Blessing Scale.\nIf you don\u2019t have any, the
      Use button will be disabled."
  - icon: {fileID: 389435072415682059, guid: 26dce2d605b9241b8853e8603d45376e, type: 3}
    text: "The preview shows your current cap and what it becomes after using a scale:\nCap:
      current \u2192 after"
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: "Blessings last for a limited time.\nIf one is active, you\u2019ll see
      the countdown here."
  - icon: {fileID: -923432448004486077, guid: 7f1ca29997ecc4af18e4b9811ea64c05, type: 3}
    text: "Each Job Site can only hold a limited number of blessing boosts at a time.\nIf
      the site is at its limit, you won\u2019t be able to apply more right now."
  overlayRoot: {fileID: 1884359955}
  dimmerImage: {fileID: 141171316}
  iconImage: {fileID: 1680589167}
  bodyText: {fileID: 749378875}
  progressText: {fileID: 1706963853}
  nextButton: {fileID: 2100592997}
  nextButtonLabel: {fileID: 201362426}
  closeButton: {fileID: 881826004}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
