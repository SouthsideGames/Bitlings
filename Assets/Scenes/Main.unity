--- !u!114 &1649229074
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1649229072}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_recycle_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: -594170056779438148, guid: 422e7fbf2f358417a91f2853e1fa02b1, type: 3}
    text: 'Recycle lets you convert one resource into another using preset recipes.

      Pick
      a recipe, then press Convert to exchange your resources.'
  - icon: {fileID: 4224842080577397726, guid: 67fb90c04d1f64b52b10ac50b26e288b, type: 3}
    text: 'The panel shows all available recycle recipes.

      Each recipe displays
      what you spend and what you receive.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Tap a recipe to select it.

      The Convert button is disabled until
      you select a recipe.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Convert only becomes available if you have enough of the required resource.

      If
      your resource amount changes while the panel is open, the button will update.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'When you convert:

      The cost resource is spent

      The reward
      resource is added

      Your resource totals refresh across the game'
  - icon: {fileID: 7919402128709028535, guid: f45c9a2b15b7e4f4f9a1f085243b0654, type: 3}
    text: A success banner appears briefly after a successful conversion.
  - icon: {fileID: 1188854595336862080, guid: 48ea91dc67a5741889448f45712b1249, type: 3}
    text: "If Convert is disabled, you don\u2019t have enough of the required resource.\nTry
      a different recipe or earn more of the input resource first."
  overlayRoot: {fileID: 515738634}
  dimmerImage: {fileID: 2012445807}
  iconImage: {fileID: 29341285}
  bodyText: {fileID: 57493842}
  progressText: {fileID: 251020613}
  nextButton: {fileID: 1906513728}
  nextButtonLabel: {fileID: 2563645}
  closeButton: {fileID: 1609279348}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
