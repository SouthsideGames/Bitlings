MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2112403539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_codex_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: -4558392863033225600, guid: fe427cde687b7429597c8cf965901e87, type: 3}
    text: The Directory is your Bitling collection log, tracking your team, owned
      Bitlings, and all discovered entries.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'The top row displays your active team.

      Select a team member to
      review details and manage assignments.'
  - icon: {fileID: 21300000, guid: 81a757657c21f19439ffc846371b559c, type: 3}
    text: 'The main list represents your collection.

      Discovered Bitlings appear
      with limited information, while owned Bitlings display full details.'
  - icon: {fileID: -1452550890681560563, guid: 7cf1507c7d54444958852c79bb125e96, type: 3}
    text: Sorting options allow the Codex to be organized by ID, name, type, or level.
  - icon: {fileID: -5907155427544933479, guid: 903d9310dcd9a49b2b5f87002b4f28d4, type: 3}
    text: Additional filters, such as Captured Only and Favorites, become available
      as they are unlocked.
  - icon: {fileID: -7138748528122379797, guid: 87c69a443195e44dfb3073efa9687483, type: 3}
    text: Bitlings can be marked as Favorites for quick access once the feature is
      available.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Select any Bitling to open its detail view and review performance or adjust
      team placement.
