  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_stat_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 2291750746404757969, guid: ce3a6dc26e8c44aada3227991627a8e0, type: 3}
    text: This panel manages Bitling progression through Growth Cores and stat allocation.
  - icon: {fileID: 1188854595336862080, guid: 48ea91dc67a5741889448f45712b1249, type: 3}
    text: "The header displays the Bitling\u2019s name, level, available stat points,
      and Growth Core requirement for the next level."
  - icon: {fileID: 4777373978525877068, guid: 7e9b6a9c3f0754d0fb8d6525fca31f2a, type: 3}
    text: 'Level Up allocates Growth Cores to increase level and generate stat points.

      Leveling
      is unavailable if Growth Cores are insufficient or the Bitling has reached
      its limit.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Unspent stat points can be assigned to health, attack, defense, or speed.

      Stat
      values update immediately, with pending increases clearly indicated.'
  - icon: {fileID: -1527303591572561236, guid: 3ba2637029c5c4ec0a519bf5a5b47d93, type: 3}
    text: Confirm applies allocated stat points once at least one point has been
      assigned.
  - icon: {fileID: 7919402128709028535, guid: f45c9a2b15b7e4f4f9a1f085243b0654, type: 3}
    text: Preset allocations become available after unlocking and apply a predefined
      distribution pattern.
  - icon: {fileID: 5798008345902572713, guid: 398cbd3dce9364b259ad047d0b457946, type: 3}
    text: Selected presets are retained for future progression.
  - icon: {fileID: -6803709588388684265, guid: 97c560992d5224132848820de6c01194, type: 3}
    text: Closing the panel does not apply changes unless progression or confirmation
      has been completed.
