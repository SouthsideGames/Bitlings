--- !u!114 &2112403541
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2112403539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_codex_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: -4558392863033225600, guid: fe427cde687b7429597c8cf965901e87, type: 3}
    text: "The Codex is your Bitling collection log.\nIt shows your team, your owned
      Bitlings, and any species you\u2019ve discovered."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'The top row is your Team.

      Tap a team member to view details and
      manage your active lineup.'
  - icon: {fileID: 4224842080577397726, guid: 67fb90c04d1f64b52b10ac50b26e288b, type: 3}
    text: 'This list is your collection.

      Discovered Bitlings appear here even
      if you have not captured them yet.'
  - icon: {fileID: 21300000, guid: 81a757657c21f19439ffc846371b559c, type: 3}
    text: 'Discovered Bitlings may show as silhouettes or limited info.

      Captured
      Bitlings show full details once you own them.'
  - icon: {fileID: -1452550890681560563, guid: 7cf1507c7d54444958852c79bb125e96, type: 3}
    text: "Use the Sort dropdown to change how your Codex is organized\u2014\nby
      ID, name, type, level, or shiny-only."
  - icon: {fileID: -5907155427544933479, guid: 903d9310dcd9a49b2b5f87002b4f28d4, type: 3}
    text: "Some filters unlock later, such as Captured Only and Favorites.\nIf you
      don\u2019t see a filter yet, it has not been unlocked."
  - icon: {fileID: -7138748528122379797, guid: 87c69a443195e44dfb3073efa9687483, type: 3}
    text: 'Mark Bitlings as Favorites to quickly find them later.

      Favorites
      filtering becomes available once unlocked.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Tap a Bitling in the Codex to open the Detail view.

      From there
      you can review stats and manage your team.'
  overlayRoot: {fileID: 252739462}
  dimmerImage: {fileID: 1307606636}
  iconImage: {fileID: 984155245}
  bodyText: {fileID: 1299311226}
  progressText: {fileID: 1189700300}
  nextButton: {fileID: 892238810}
  nextButtonLabel: {fileID: 444942407}
  closeButton: {fileID: 816374008}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
