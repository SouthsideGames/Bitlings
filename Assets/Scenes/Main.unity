  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_cryolab_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 27cd7154c3249954ba26302bc13ef129, type: 3}
    text: Cryo Lab lets you use Work Orders to activate a temporary bonus that improves
      your capture operations for a limited time.
  - icon: {fileID: -184922529597343108, guid: 242083f04895f496db58523ff283ee47, type: 3}
    text: "Activating a Work Order consumes 1 Work Order (if consumption is enabled).\nIf
      you don\u2019t have any, the button will be disabled."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Tap Use to activate the Work Order.

      The boost begins immediately
      and lasts for a set duration.'
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: 'The timer shows how much time is left on your active Work Order.

      When
      it reaches zero, the Work Order expires.'
  - icon: {fileID: -923432448004486077, guid: 7f1ca29997ecc4af18e4b9811ea64c05, type: 3}
    text: 'Only one Work Order can be active at a time.

      Using another one
      will replace the current active Work Order.'
