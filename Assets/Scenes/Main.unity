  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_recycle_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: -594170056779438148, guid: 422e7fbf2f358417a91f2853e1fa02b1, type: 3}
    text: Recycling converts resources into other materials using predefined recipes.
  - icon: {fileID: 4224842080577397726, guid: 67fb90c04d1f64b52b10ac50b26e288b, type: 3}
    text: Select a recipe to view the required cost and resulting output.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Conversion becomes available once sufficient resources are present.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Availability updates automatically as resource totals change.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: When confirmed, required resources are deducted and new materials are added,
      with totals updating across all systems.
  - icon: {fileID: 7919402128709028535, guid: f45c9a2b15b7e4f4f9a1f085243b0654, type: 3}
    text: A confirmation message appears after a successful conversion.
  - icon: {fileID: 1188854595336862080, guid: 48ea91dc67a5741889448f45712b1249, type: 3}
    text: If conversion is unavailable, additional resources are required before
      proceeding.
