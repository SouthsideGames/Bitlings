    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[10].text
      value: 'The Info button opens the Bitlings Manual.

        Use it anytime
        to learn how systems, jobs, and mechanics work.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
