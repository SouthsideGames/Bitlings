  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_wyrmden_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 9547edd03db9c8545982eef5d6710e5c, type: 3}
    text: Wyrm Den lets you spend Favor to activate a temporary boost that increases
      encounter odds for a limited time.
  - icon: {fileID: 5787554331827840099, guid: 70dc8220ffe4d425cbbe0cbe67177f0d, type: 3}
    text: "Activating the boost costs 1 Favor (if consumption is enabled).\nIf you
      don\u2019t have Favor, you can\u2019t activate the boost."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "You can only have one active Favor boost at a time.\nWhile it\u2019s active,
      the Use button is disabled."
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: 'The timer shows how long your Favor boost remains active.

      When
      time runs out, the boost ends automatically.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Tap Use to start the boost immediately.

      Your Favor boost lasts
      for a set number of hours.'
