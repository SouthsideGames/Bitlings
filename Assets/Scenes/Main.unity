  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_harbor_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 1f479cd953739c34781f1981870c344a, type: 3}
    text: Harbor lets you use Flyers to increase the chance of encountering a specific
      type of Bitling for a limited time.
  - icon: {fileID: 21300000, guid: fb4479ed54fe64621a9e7a735eeffad8, type: 3}
    text: Use the dropdown to select the Monster Type you want to find more often.
  - icon: {fileID: 3321169378428917069, guid: d2a224ffc5dd14cd9bea2e051ae55a5d, type: 3}
    text: 'Press Use Flyer to activate a boost.

      If Flyers are consumed, you
      must have at least 1 Flyer available.'
  - icon: {fileID: 5459842371491020445, guid: 5efcd2481dca747a4b1c5a9dbe3f138d, type: 3}
    text: 'This panel shows your estimated current chance to encounter that type,

      and
      the estimated chance after using a flyer.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'When a Flyer is active, the type icon appears here and the timer counts
      down.

      Using a new flyer replaces the current one.'
