  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_wyrmden_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: be6f0ae4213c16843b4aa2109fa8306d, type: 3}
    text: The Wyrm Den uses Favor to activate a temporary boost that increases encounter
      rates for a limited time.
  - icon: {fileID: 5787554331827840099, guid: 70dc8220ffe4d425cbbe0cbe67177f0d, type: 3}
    text: Activating the boost consumes one Favor and applies the effect immediately,
      based on available supply.
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: An active boost displays a countdown timer and ends automatically when
      time expires.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Only one Favor boost can be active at a time.
