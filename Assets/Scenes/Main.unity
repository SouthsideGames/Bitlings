--- !u!114 &1888682016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1888682014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_exchange_market_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'The Exchange is the central hub for tracking Bitling valuation, managing
      assets, fulfilling requests, and monitoring market activity.

      Use the
      tabs at the top to navigate between sections.'
  - icon: {fileID: -7295365811650195547, guid: 51e6357dfbfec4d66a5a69c30be3d1a8, type: 3}
    text: 'The Market displays all discovered Bitlings and their current valuation.

      Select
      a Bitling to review details or open its full market breakdown.


      Listings
      can be sorted by valuation, trend, or rarity to identify strong exchange opportunities.'
  - icon: {fileID: -4605754898164830102, guid: c50b216e7dfb54461ae0609f42abc850, type: 3}
    text: 'The Portfolio displays all owned Bitlings and their combined market value.

      Use
      this view to assess total asset strength and overall Credit return potential.'
  - icon: {fileID: -8862821924039853696, guid: 86b71ab558cbe42cd99d41d64ee42683, type: 3}
    text: 'Requests are active market offers seeking specific Bitlings.

      Fulfilling
      a request removes the Bitling from your roster and provides Credits or additional
      resources.'
  - icon: {fileID: -8862821924039853696, guid: 86b71ab558cbe42cd99d41d64ee42683, type: 3}
    text: 'Confirmation is required before completing a request to ensure accuracy.

      Review
      all details before finalizing the exchange.'
  - icon: {fileID: -6541873949021656346, guid: 1f3305ea14942441b886d3feb22a26a5, type: 3}
    text: 'The Trends tab highlights Bitlings with rising or falling valuation.

      Use
      this view to monitor market shifts and adjust exchange decisions.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'The ticker displays real-time updates on Bitling valuation changes.

      Indicators
      reflect upward or downward market movement.'
  - icon: {fileID: 5950916706163890335, guid: be83edde61ed04f7b9773a2adcc9d933, type: 3}
    text: 'Bull and Bear tokens allow controlled influence over Bitling valuation
      once unlocked.

      These tools can adjust market direction when applied.'
  - icon: {fileID: 5950916706163890335, guid: be83edde61ed04f7b9773a2adcc9d933, type: 3}
    text: 'Tabs can be accessed at any time to move between Market, Portfolio, Requests,
      and Trends.

      All sections update dynamically based on current market
      conditions.'
  overlayRoot: {fileID: 510820295}
  dimmerImage: {fileID: 59601533}
  iconImage: {fileID: 1209320310}
  bodyText: {fileID: 1721728932}
  progressText: {fileID: 831325635}
  nextButton: {fileID: 1614683833}
  nextButtonLabel: {fileID: 2104740197}
  closeButton: {fileID: 1108186387}
  skipButton: {fileID: 21818665}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
