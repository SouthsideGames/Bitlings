    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[10].text
      value: 'Energy is displayed at the top of the screen.

        Rift Operations
        require Energy, which regenerates over time.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
