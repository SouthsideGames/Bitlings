--- !u!114 &296925173
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 296925171}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_gym_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: e5fb26b3af00b2549949286c76126ab7, type: 3}
    text: 'The Gym lets you spend Growth Cores to level up your Bitlings.

      Pick
      a Bitling from the list to open the leveling panel.'
  - icon: {fileID: 2291750746404757969, guid: ce3a6dc26e8c44aada3227991627a8e0, type: 3}
    text: This number shows how many Growth Cores you currently have available to
      spend.
  - icon: {fileID: 21300000, guid: 81a757657c21f19439ffc846371b559c, type: 3}
    text: 'This list includes every Bitling you own, including team + bench.

      Tap
      a row to manage leveling for that Bitling.'
  - icon: {fileID: -5907155427544933479, guid: 903d9310dcd9a49b2b5f87002b4f28d4, type: 3}
    text: 'Tap a Bitling row to open its leveling panel.

      That panel is where
      Growth Cores are spent and upgrades are applied.'
  - icon: {fileID: -923432448004486077, guid: 7f1ca29997ecc4af18e4b9811ea64c05, type: 3}
    text: "If you have 0 Growth Cores, the row\u2019s Open button will be disabled.\nEarn
      more Growth Cores, then come back to level up."
  - icon: {fileID: -6288249182244823202, guid: bde71cd552fb546aaa1d2775dd746969, type: 3}
    text: 'Auto Apply lets a Bitling automatically spend Growth Cores when eligible.

      This
      toggle only appears after you unlock Auto Growth.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Only a limited number of Bitlings can have Auto Apply enabled at once.

      If
      you hit the limit, turning on another Auto Apply toggle will be blocked.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: When Auto Apply is enabled on at least one Bitling, this banner appears
      to remind you Auto Apply is active.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: When you enable Auto Apply, the Bitling sets a target level at least one
      level higher than its current level.
  - icon: {fileID: 5798008345902572713, guid: 398cbd3dce9364b259ad047d0b457946, type: 3}
    text: 'Your Auto Apply settings are saved automatically.

      If you toggle
      Auto Apply on or off, it is immediately stored.'
  overlayRoot: {fileID: 1851425252}
  dimmerImage: {fileID: 1917758492}
  iconImage: {fileID: 2129673442}
  bodyText: {fileID: 1054104462}
  progressText: {fileID: 24053937}
  nextButton: {fileID: 212165369}
  nextButtonLabel: {fileID: 2037801088}
  closeButton: {fileID: 1824883749}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
