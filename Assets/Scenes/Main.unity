  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1735073259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_dossier_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 1489862017677310444, guid: 033c0ad5a6b064626a952f911823f8cf, type: 3}
    text: "This is your Player Dossier.\nIt\u2019s your BRN handler record\u2014tracking
      your progress across jobs, encounters, and resources."
  - icon: {fileID: -2033256211590696452, guid: 3025331faab17431e87807de0219c172, type: 3}
    text: 'Use Next and Prev to move through the dossier pages.

      On Page 1,
      you can Close to return home.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 1 \u2013 Overview shows your handler identity, collection progress,
      and your Care Score summary."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 2 \u2013 Job Network shows which Job Sites you\u2019ve unlocked and
      how your workforce is performing."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 3 \u2013 Field Operations tracks encounters, capture performance,
      and notable highlights from the field."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 4 \u2013 Resources is a quick summary of what you currently have.\nUse
      the main Resources panel for full details."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 5 \u2013 BRN R\xE9sum\xE9 is a narrative summary of your record.\nIt
      updates automatically as you play."
  overlayRoot: {fileID: 1980897493}
  dimmerImage: {fileID: 1352943133}
  iconImage: {fileID: 363891473}
  bodyText: {fileID: 598778896}
  progressText: {fileID: 1271997935}
