--- !u!114 &599446431
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 599446429}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_expedition_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 7f317b7b8dc50b341a110515859f3747, type: 3}
    text: 'Expedition is where Pack Vouchers are used to unlock new Bitling Packs.

      These
      packs expand your collection and provide access to new Bitlings.'
  - icon: {fileID: 4224842080577397726, guid: 67fb90c04d1f64b52b10ac50b26e288b, type: 3}
    text: 'The header displays your available Pack Vouchers.

      Vouchers are
      required to unlock new Bitling Packs.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'All packs from the current rotation are listed here.

      Locked packs
      appear first, making it easier to identify new unlock opportunities.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Select a pack to review its contents and unlock requirements.

      Each
      pack contains a curated set of Bitlings.'
  - icon: {fileID: -109353936457988245, guid: df23d2ef5229744a0a8cc432cfb15ddd, type: 3}
    text: 'Unlocking a pack consumes Pack Vouchers and adds it to your available
      pool.

      Once unlocked, the pack becomes accessible for future use.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Expedition packs rotate over time.

      New packs become available as
      the current rotation updates.'
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: 'The timer displays how long the current pack rotation remains active.

      When
      the timer ends, a new set of packs becomes available.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Unlocking packs increases access to new Bitlings and strengthens your
      roster.

      Continue using Pack Vouchers to expand BRN collection capabilities.'
  overlayRoot: {fileID: 501324132}
  dimmerImage: {fileID: 942229809}
