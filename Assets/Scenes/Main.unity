  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_shadowmarket_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 3f7e997bc9e4d774d842b2eab5055ca8, type: 3}
    text: Shadow Market lets you spend Shiny Orbs to activate a temporary Shiny Boost.
  - icon: {fileID: 3084012362977371794, guid: e2d3b8730a443435bb167b9bcdacd4eb, type: 3}
    text: 'Activating the boost costs 1 Shiny Orb.

      If you have none, the button
      will be disabled.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Tap Use Orb to start the boost.

      The boost increases shiny results
      for a limited time.'
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: 'The timer shows how long your Shiny Boost remains active.

      When
      time runs out, the boost ends automatically.'
  - icon: {fileID: -923432448004486077, guid: 7f1ca29997ecc4af18e4b9811ea64c05, type: 3}
    text: 'Only one Shiny Boost can be active at a time.

      Using another orb
      will replace the current boost.'
