    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.size
      value: 12
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[2].text
      value: 'The Directory tracks every Bitling you discover.

        View their
        details and assign them to your active team.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[3].text
      value: 'Rift Operations deploy your team to stabilize unassigned Bitlings.

        Each
        operation requires Energy and an active team.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[5].icon
      value: 
      objectReference: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[6].text
      value: Select colored job site icon to review details and manage assignments.
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[7].text
      value: 'The Player icon opens your BRN Resume.

        Review your progress,
        performance, and Handler status.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[8].text
      value: The Resources panel displays all available materials and their operational
        use.
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[9].icon
      value: 
      objectReference: {fileID: -7295365811650195547, guid: 51e6357dfbfec4d66a5a69c30be3d1a8, type: 3}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[9].text
      value: 'Bitlings can be exchanged for Credits based on current market valuation.

        Values
        shift with demand and market trends. Monitor market demand to secure stronger
        exchange outcomes.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[10].icon
      value: 
      objectReference: {fileID: 1188854595336862080, guid: 48ea91dc67a5741889448f45712b1249, type: 3}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[10].text
      value: 'The Info panel provides access to the BRN Manual.

        Use it to
        review systems, job sites, and operational guidance.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[11].icon
      value: 
      objectReference: {fileID: 8607699008840149923, guid: 489c34973596a4709b5f608ee5e8ec6d, type: 3}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[11].text
      value: 'Energy is displayed at the top of the screen.

        Rift Operations
        require Energy, which regenerates over time.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[12].icon
      value: 
      objectReference: {fileID: 8607699008840149923, guid: 489c34973596a4709b5f608ee5e8ec6d, type: 3}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[12].text
      value: "Your current Energy is shown at the top. Encounters require Energy,
        so if you\u2019re low, you may need to wait for it to regenerate."
      objectReference: {fileID: 0}
