    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[2].text
      value: 'The Directory tracks every Bitling you discover.

        View their
        details and assign them to your active team.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[3].text
      value: 'Rift Operations deploy your team to stabilize unassigned Bitlings.

        Each
        operation requires Energy and an active team.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
      propertyPath: pages.Array.data[5].icon
