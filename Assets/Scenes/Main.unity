--- !u!114 &1174587167
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1174587165}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_ironcareer_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'You are entering Executive Trial.

      This is a high-risk operation
      mode where mistakes carry lasting consequences.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "If a Bitling\u2019s health reaches zero, it is permanently removed from
      the active roster for that run.\nRecovery is not available once a Bitling is
      lost."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Health does not fully reset between engagements.

      Damage carries
      forward, making long-term stability a critical part of each decision.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Executive Trial operates under restricted conditions, with outside assistance
      and safety systems unavailable.

      Each run is fully self-contained.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Every victory follows a fixed progression sequence: Hire or Replace, Post
      Screen review, Forced Evolution, milestone Rest, then the next engagement.

      Operational
      flow cannot be skipped.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "After every 3 victories, a Rest Node becomes available.\nAt that point,
      you may restore part of the team\u2019s health or grant a level increase to
      one party member."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'If the run is ended early, the operation is closed immediately.

      Executive
      Trial does not allow resume or retry.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Executive Trial rewards careful planning, controlled risk, and disciplined
      team management.

      Once the operation begins, every decision matters.'
  overlayRoot: {fileID: 1404034668}
  dimmerImage: {fileID: 1261265346}
  iconImage: {fileID: 455197505}
  bodyText: {fileID: 1950192887}
  progressText: {fileID: 1219239946}
  nextButton: {fileID: 25109069}
  nextButtonLabel: {fileID: 1755739290}
  closeButton: {fileID: 1801486970}
  skipButton: {fileID: 1867337804}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
