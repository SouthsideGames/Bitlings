      propertyPath: pages.Array.data[9].text
      value: 'Sell Bitlings for Credits based on market value.

        Prices change
        depending on demand and trends.


        Tip:

        Sell during high
        demand for maximum profit.'
      objectReference: {fileID: 0}
    - target: {fileID: 7178327539474743040, guid: e2a738edca0ab1341b3614d8ebf7e6b6, type: 3}
