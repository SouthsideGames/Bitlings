MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 228074375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_exchangedetail_market_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'This panel shows the full market details for a selected Bitling.

      Review
      its valuation, trend, demand, and available exchange options here.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "This displays the Bitling\u2019s current market valuation.\nIf an arrow
      appears, the valuation changed during the most recent market update."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Demand shows current market interest in this Bitling.

      Trend shows
      whether its valuation is rising, falling, or remaining stable.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Broker Payout shows how many Credits this Bitling would return if exchanged
      through a broker.

      Use this value to review its immediate exchange return.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Additional market tools unlock over time.

      Forecast provides a preview
      of expected demand for this Bitling during the next market cycle.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'When unlocked, Surge Alerts allow selected Bitlings to be monitored more
      closely.

      When enabled, this helps track Bitlings showing strong market
      activity.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "If a monopoly is active for this Bitling\u2019s type, all Bitlings of
      that type receive a valuation bonus.\nThis increases their overall exchange
      value while the bonus remains active."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "When unlocked, Bull and Bear Tokens allow controlled influence over this
      Bitling\u2019s market direction.\nBull Tokens support upward movement, while
      Bear Tokens apply downward pressure."
