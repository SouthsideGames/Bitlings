  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_jobassign_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'This panel lets you assign Bitlings to a Job Site.

      Assigned Bitlings
      work automatically and generate resources over time.'
  - icon: {fileID: 1420780651364645667, guid: 9923bea833c8b4a55934a79e6f41459f, type: 3}
    text: 'Tap an empty slot to assign a Bitling.

      Each Job Site can have multiple
      slots, depending on upgrades.'
  - icon: {fileID: -184233537094302185, guid: 6b23ba550c98a4db89080b5bf92724f0, type: 3}
    text: 'Jobs take time to complete.

      You can check progress here and collect
      rewards when the job finishes.'
  - icon: {fileID: -923432448004486077, guid: 7f1ca29997ecc4af18e4b9811ea64c05, type: 3}
    text: 'Some Bitlings may need rest before working again.

      Managing assignments
      helps you earn resources more efficiently.'
  overlayRoot: {fileID: 1550959207}
  dimmerImage: {fileID: 115021182}
  iconImage: {fileID: 2038279614}
