--- !u!114 &1735073261
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1735073259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_dossier_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 1489862017677310444, guid: 033c0ad5a6b064626a952f911823f8cf, type: 3}
    text: 'This is your Player Dossier.

      It serves as your BRN Handler record,
      tracking progress across job sites, Rift Operations, and resources.'
  - icon: {fileID: -2033256211590696452, guid: 3025331faab17431e87807de0219c172, type: 3}
    text: 'Use Next and Prev to navigate between dossier pages.

      Select Close
      on the first page to return to the Home screen.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 1 \u2013 Overview displays your Handler designation, collection progress,
      and Care Score summary."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 2 \u2013 Job Network shows unlocked job sites and overall workforce
      performance."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 3 \u2013 Field Operations tracks Rift Operations, capture performance,
      and key field activity."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 4 \u2013 Resources provides a summary of current materials.\nUse
      the main Resources panel for detailed information."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 5 \u2013 BRN Resume presents a narrative summary of your operational
      record, updating automatically over time."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 6 \u2013 Achievements track long-term progress across Bitlings, unlocking
      permanent badges as objectives are completed."
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: "Page 7 \u2013 Player Rank displays your current rank and upcoming rewards."
  overlayRoot: {fileID: 1980897493}
  dimmerImage: {fileID: 1352943133}
  iconImage: {fileID: 363891473}
  bodyText: {fileID: 598778896}
  progressText: {fileID: 1271997935}
  nextButton: {fileID: 1058612013}
  nextButtonLabel: {fileID: 253351119}
  closeButton: {fileID: 2086231549}
  skipButton: {fileID: 427057746}
