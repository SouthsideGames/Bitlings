--- !u!114 &461772030
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 461772028}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_forge_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: -82702583781362031, guid: d2da644c3f7344a6aa777c14615a5e47, type: 3}
    text: 'The Forge allocates Materials to improve job sites across BRN operations.

      Each
      Material contributes progress toward the next job site level.'
  - icon: {fileID: 21300000, guid: 2e11d61ac1bc14127996bbe122e09798, type: 3}
    text: 'Only unlocked job sites are displayed.

      Unavailable sites have not
      yet been activated.'
  - icon: {fileID: -82702583781362031, guid: d2da644c3f7344a6aa777c14615a5e47, type: 3}
    text: "Materials can be distributed across multiple job sites as needed. \nAvailable
      Materials are shown at the top of the panel."
  - icon: {fileID: 1420780651364645667, guid: 9923bea833c8b4a55934a79e6f41459f, type: 3}
    text: Allocations are limited by current Material availability.
  - icon: {fileID: -923432448004486077, guid: 7f1ca29997ecc4af18e4b9811ea64c05, type: 3}
    text: Spending cannot exceed stored resources.
  - icon: {fileID: 7919402128709028535, guid: f45c9a2b15b7e4f4f9a1f085243b0654, type: 3}
    text: Confirm to apply allocations and update job site progress immediately.
  - icon: {fileID: -6803709588388684265, guid: 97c560992d5224132848820de6c01194, type: 3}
    text: Cancel to revert pending changes to the previous state.
  - icon: {fileID: -4192873577498990268, guid: 3488ad4b336d946b7abcb675644295f3, type: 3}
    text: When a job site reaches its progress threshold, it advances to the next
      level and resets its progress.
  overlayRoot: {fileID: 1977617443}
  dimmerImage: {fileID: 727092672}
  iconImage: {fileID: 356480767}
