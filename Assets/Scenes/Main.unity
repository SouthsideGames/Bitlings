--- !u!114 &296925173
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 296925171}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_gym_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 7a1f366d7e37345d497f3ea3f32e724f, type: 3}
    text: The Gym allocates Growth Cores to increase Bitling levels.
  - icon: {fileID: 21300000, guid: 81a757657c21f19439ffc846371b559c, type: 3}
    text: Select a Bitling to open its leveling panel and apply upgrades.
  - icon: {fileID: 3793622260316442973, guid: cd08b47c2e9ee49569739413bba69e51, type: 3}
    text: Available Growth Cores are displayed at the top of the panel.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: All owned Bitlings are listed, including active team members and reserves.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Selecting a Bitling opens its leveling panel, where Growth Cores are applied.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Leveling becomes available only when sufficient Growth Cores are present.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Auto Growth allows Bitlings to automatically allocate Growth Cores when
      eligible.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: This feature becomes available once unlocked and is limited to a set number
      of Bitlings.
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Active Auto Growth settings are indicated and saved automatically.
  - icon: {fileID: 5798008345902572713, guid: 398cbd3dce9364b259ad047d0b457946, type: 3}
    text: Each enabled Bitling maintains a target level for continued progression.
  overlayRoot: {fileID: 1851425252}
  dimmerImage: {fileID: 1917758492}
  iconImage: {fileID: 2129673442}
  bodyText: {fileID: 1054104462}
  progressText: {fileID: 24053937}
  nextButton: {fileID: 212165369}
  nextButtonLabel: {fileID: 2037801088}
  closeButton: {fileID: 1824883749}
  skipButton: {fileID: 1758330556}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
