--- !u!114 &355745688
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 355745685}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_home_v1
  autoOpenOnEnable: 1
  pages:
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Welcome to Bitlings.

      Build a team, unlock new features, and put
      your Bitlings to work to earn resources over time.'
  - icon: {fileID: 4349945301068942552, guid: 7c93b805f2a3e4aca8ce46843848798b, type: 3}
    text: 'Upgrades unlock permanent features and long-term boosts.

      Purchase
      upgrades here to expand what you can do in Bitlings.'
  - icon: {fileID: -4558392863033225600, guid: fe427cde687b7429597c8cf965901e87, type: 3}
    text: 'The Codex tracks every Bitling you discover.

      You can view their
      details and assign Bitlings to your active team.'
  - icon: {fileID: 1006166679981420889, guid: 10c4c40dbdebe477bb559690eb655118, type: 3}
    text: 'Encounters let your team battle wild Bitlings.

      Encounters cost
      Energy and require an active team.'
  - icon: {fileID: -6288249182244823202, guid: bde71cd552fb546aaa1d2775dd746969, type: 3}
    text: Settings lets you adjust game options and preferences.
  - icon: {fileID: 21300000, guid: 7e84e22fc3f7fac439d147617be35a23, type: 3}
    text: "The center of the Home screen is your Job Site area.\nJob Sites unlock
      when you own a Bitling of that type.\nSome Job Sites open additional panels
      \u2014 tap the job icon to manage them.\nVisit Info for full details."
  - icon: {fileID: 1489862017677310444, guid: 033c0ad5a6b064626a952f911823f8cf, type: 3}
    text: 'The Player icon opens your Player Resume.

      Review your progress,
      performance, and overall handler status here.'
  - icon: {fileID: 5850959938036106380, guid: 5f95a3f680219432e91ebcb19c657666, type: 3}
    text: 'The Resources panel shows how many of each resource you have

      and
      where they are used throughout the game.'
  - icon: {fileID: 1188854595336862080, guid: 48ea91dc67a5741889448f45712b1249, type: 3}
    text: 'The Info button opens the Bitlings Manual.

      Use it anytime to learn
      how systems, jobs, and mechanics work.'
  overlayRoot: {fileID: 2095525497}
  dimmerImage: {fileID: 40270858}
  iconImage: {fileID: 223813428}
  bodyText: {fileID: 1031350351}
  progressText: {fileID: 1802353973}
  nextButton: {fileID: 1136684885}
  nextButtonLabel: {fileID: 1162010346}
  closeButton: {fileID: 1448088138}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
