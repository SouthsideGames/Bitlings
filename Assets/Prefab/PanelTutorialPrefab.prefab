--- !u!114 &7178327539474743040
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 74038546262375186}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aea490f53db83604eae9c1658210a5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialKey: tut_home_v1
  autoOpenOnEnable: 0
  pages:
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: 'Welcome to BRN operations.

      Build your team, unlock new functions,
      and assign Bitlings to job sites to generate resources over time.'
  - icon: {fileID: 4349945301068942552, guid: 7c93b805f2a3e4aca8ce46843848798b, type: 3}
    text: 'Upgrades expand BRN capabilities through permanent enhancements.

      Apply
      upgrades here to unlock new systems and improve long-term performance.'
  - icon: {fileID: -4558392863033225600, guid: fe427cde687b7429597c8cf965901e87, type: 3}
    text: 'The Directory tracks all discovered Bitlings.

      Review their details
      and assign them to your active team.'
  - icon: {fileID: 1006166679981420889, guid: 10c4c40dbdebe477bb559690eb655118, type: 3}
    text: 'Encounters deploy your team to engage unassigned Bitlings.

      Each
      encounter requires Energy and an active team.'
  - icon: {fileID: -6288249182244823202, guid: bde71cd552fb546aaa1d2775dd746969, type: 3}
    text: Settings allow you to adjust system preferences and configurations.
  - icon: {fileID: 21300000, guid: 7e84e22fc3f7fac439d147617be35a23, type: 3}
    text: 'The center of the Home screen displays your Job Sites.

      Job Sites
      unlock when a compatible Bitling is assigned, and can be managed directly from
      their icons.'
  - icon: {fileID: 21300000, guid: 5b05ebb3f339e4f03b3026941ea99ecc, type: 3}
    text: Tap any colored job site icon to view details and manage that job site.
  - icon: {fileID: 1489862017677310444, guid: 033c0ad5a6b064626a952f911823f8cf, type: 3}
    text: 'The Player icon opens your Player Resume.

      Review your progress,
      performance, and overall handler status here.'
  - icon: {fileID: 5850959938036106380, guid: 5f95a3f680219432e91ebcb19c657666, type: 3}
    text: 'The Resources panel shows how many of each resource you have

      and
      where they are used throughout the game.'
  - icon: {fileID: 1188854595336862080, guid: 48ea91dc67a5741889448f45712b1249, type: 3}
    text: 'The Info button opens the Bitlings Manual.

      Use it anytime to learn
      how systems, jobs, and mechanics work.'
  overlayRoot: {fileID: 4799221346322076826}
  dimmerImage: {fileID: 725775496448763678}
  iconImage: {fileID: 9175144054656447169}
  bodyText: {fileID: 8007315493241715650}
  progressText: {fileID: 6639272359854146345}
  nextButton: {fileID: 6850815471596285436}
  nextButtonLabel: {fileID: 87144556353385174}
  closeButton: {fileID: 5242002168292565671}
  skipButton: {fileID: 2847656614888363847}
  allowEarlyClose: 0
  completeOnlyOnLastSlide: 1
